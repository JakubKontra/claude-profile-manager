#!/usr/bin/env bash
# Generated by cpm (Claude Profile Manager)
# Profile: personal — Personal
set -euo pipefail

# Unset inherited CLAUDE_*/ANTHROPIC_* env vars to avoid interference
while IFS= read -r varname; do
  unset "$varname"
done < <(compgen -v | grep -E "^(CLAUDE_|ANTHROPIC_)" || true)

export CLAUDE_CONFIG_DIR='$ROOT/profiles/personal'
export CLAUDE_PROFILE='personal'

# Subcommands only need the environment, not profile flags
case "${1:-}" in
  mcp|auth|doctor|install|setup-token|update|upgrade|agents|auto-mode|plugin|plugins) exec claude "$@" ;;
esac

extra=()

exec claude ${extra[@]+"${extra[@]}"} "$@"
