#!/usr/bin/env bash
# Generated by cpm (Claude Profile Manager)
# Profile: work — Work
set -euo pipefail

# Unset inherited CLAUDE_*/ANTHROPIC_* env vars to avoid interference
while IFS= read -r varname; do
  unset "$varname"
done < <(compgen -v | grep -E "^(CLAUDE_|ANTHROPIC_)" || true)

export CLAUDE_CONFIG_DIR='$ROOT/profiles/work'
export CLAUDE_PROFILE='work'
export TEAM='core'

# Subcommands only need the environment, not profile flags
case "${1:-}" in
  mcp|auth|doctor|install|setup-token|update|upgrade|agents|auto-mode|plugin|plugins) exec claude "$@" ;;
esac

extra=()
extra+=(--add-dir '$ROOT/home/Work')
# Default model (overridden if --model is passed on command line)
has_model=false
for arg in "$@"; do
  case "$arg" in
    --model|--model=*) has_model=true; break ;;
  esac
done
if [ "$has_model" = false ]; then extra+=(--model 'sonnet'); fi

exec claude ${extra[@]+"${extra[@]}"} "$@"
